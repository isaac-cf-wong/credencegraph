{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/isaac-cf-wong/credencegraph/main/src/credencegraph/core/schema/graph-1.schema.json",
    "title": "credencegraph graph, format version 1",
    "description": "Structure and types of a credencegraph document. Unique ids, relations naming existing nodes, acyclicity of the requires/supports/refutes subgraph, and the ban on an equivalent or exclusive relation joining a node to itself are checked when the document is loaded and are not expressible here.",
    "type": "object",
    "additionalProperties": false,
    "required": ["format", "version", "nodes", "relations"],
    "properties": {
        "format": { "const": "credencegraph" },
        "version": { "const": 1 },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "relations": {
            "type": "array",
            "items": { "$ref": "#/$defs/relation" }
        }
    },
    "$defs": {
        "id": { "type": "string", "minLength": 1 },
        "point": { "type": "number", "minimum": 0, "maximum": 1 },
        "beta": {
            "type": "object",
            "additionalProperties": false,
            "required": ["alpha", "beta"],
            "properties": {
                "alpha": { "type": "number", "exclusiveMinimum": 0 },
                "beta": { "type": "number", "exclusiveMinimum": 0 }
            }
        },
        "credence": {
            "oneOf": [{ "$ref": "#/$defs/point" }, { "$ref": "#/$defs/beta" }]
        },
        "attributes": { "type": "object" },
        "anchor": {
            "type": "object",
            "additionalProperties": false,
            "required": ["document"],
            "properties": {
                "document": { "type": "string", "minLength": 1 },
                "locator": { "type": ["string", "null"], "minLength": 1 },
                "quote": { "type": ["string", "null"], "minLength": 1 },
                "digest": { "type": ["string", "null"], "minLength": 1 }
            }
        },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "script": { "type": "string", "pattern": "\\.py$" },
        "obligation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statement"],
            "properties": {
                "statement": { "type": "string", "minLength": 1 },
                "discharge": {
                    "oneOf": [
                        { "$ref": "#/$defs/discharge" },
                        { "type": "null" }
                    ]
                }
            }
        },
        "discharge": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "theorem"],
                    "properties": {
                        "kind": { "const": "formal" },
                        "theorem": { "type": "string", "minLength": 1 }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "script"],
                    "dependentRequired": {
                        "digest": ["status"],
                        "status": ["digest"]
                    },
                    "properties": {
                        "kind": { "const": "symbolic" },
                        "script": { "$ref": "#/$defs/script" },
                        "digest": { "$ref": "#/$defs/digest" },
                        "status": { "type": "integer" }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "script", "value", "tolerance"],
                    "dependentRequired": {
                        "digest": ["status"],
                        "status": ["digest"]
                    },
                    "properties": {
                        "kind": { "const": "numerical" },
                        "script": { "$ref": "#/$defs/script" },
                        "digest": { "$ref": "#/$defs/digest" },
                        "status": { "type": "integer" },
                        "value": { "type": "number" },
                        "tolerance": { "type": "number", "exclusiveMinimum": 0 }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "anchor"],
                    "properties": {
                        "kind": { "const": "citation" },
                        "anchor": {
                            "allOf": [
                                { "$ref": "#/$defs/anchor" },
                                {
                                    "required": ["quote"],
                                    "properties": {
                                        "quote": { "type": "string" }
                                    }
                                }
                            ]
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind"],
                    "properties": { "kind": { "const": "judgement" } }
                }
            ]
        },
        "node": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
                "id": { "$ref": "#/$defs/id" },
                "kind": { "type": "string", "minLength": 1 },
                "statement": { "type": ["string", "null"], "minLength": 1 },
                "sources": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/anchor" }
                },
                "base": {
                    "oneOf": [
                        { "$ref": "#/$defs/credence" },
                        { "type": "null" }
                    ]
                },
                "stated": {
                    "oneOf": [
                        { "$ref": "#/$defs/credence" },
                        { "type": "null" }
                    ]
                },
                "attributes": { "$ref": "#/$defs/attributes" }
            }
        },
        "relation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "source", "target"],
            "properties": {
                "id": { "$ref": "#/$defs/id" },
                "type": { "type": "string", "minLength": 1 },
                "source": { "$ref": "#/$defs/id" },
                "target": { "$ref": "#/$defs/id" },
                "strength": {
                    "oneOf": [
                        { "$ref": "#/$defs/credence" },
                        { "type": "null" }
                    ]
                },
                "sensitivity": {
                    "oneOf": [
                        { "$ref": "#/$defs/credence" },
                        { "type": "null" }
                    ]
                },
                "false_pass": {
                    "oneOf": [
                        { "$ref": "#/$defs/credence" },
                        { "type": "null" }
                    ]
                },
                "attributes": { "$ref": "#/$defs/attributes" },
                "obligation": {
                    "oneOf": [
                        { "$ref": "#/$defs/obligation" },
                        { "type": "null" }
                    ]
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "enum": ["requires", "supports", "refutes"]
                            }
                        }
                    },
                    "then": {
                        "required": ["strength"],
                        "properties": {
                            "strength": { "$ref": "#/$defs/credence" }
                        }
                    },
                    "else": { "properties": { "strength": { "type": "null" } } }
                },
                {
                    "if": {
                        "properties": { "type": { "const": "observes" } }
                    },
                    "then": {
                        "required": ["sensitivity", "false_pass"],
                        "properties": {
                            "sensitivity": { "$ref": "#/$defs/credence" },
                            "false_pass": { "$ref": "#/$defs/credence" }
                        }
                    },
                    "else": {
                        "properties": {
                            "sensitivity": { "type": "null" },
                            "false_pass": { "type": "null" }
                        }
                    }
                },
                {
                    "if": {
                        "not": {
                            "properties": {
                                "type": {
                                    "enum": [
                                        "requires",
                                        "supports",
                                        "refutes",
                                        "equivalent",
                                        "exclusive",
                                        "observes"
                                    ]
                                }
                            }
                        }
                    },
                    "then": {
                        "properties": { "obligation": { "type": "null" } }
                    }
                }
            ]
        }
    }
}
